<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_inherit_car_rental_view_form" model="ir.ui.view">
        <field name="name">stock.picking.view.form.inherit.car.rental</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="car_rental_order_id" invisible="1"/>
                <button name="action_view_car_rental_order" type="object" class="oe_stat_button" icon="fa-car" invisible="not car_rental_order_id">
                    <span class="o_stat_text">Rental Order</span>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
