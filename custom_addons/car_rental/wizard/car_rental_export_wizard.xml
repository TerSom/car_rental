<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_car_rental_export_wizard_form" model="ir.ui.view">
        <field name="name">car.rental.export.wizard.form</field>
        <field name="model">car.rental.export.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="state"/>
                    <field name="only_overdue" />
                </group>
                <field name="xlsx_file" filename="file_name" invisible="not xlsx_file"/>
                <field name="file_name" invisible="1"/>
                <footer>
                    <button name="action_generate_xlsx" string="Generate Excel" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_export_orders_wizard" model="ir.actions.act_window">
        <field name="name">Export Orders to Excel</field>
        <field name="res_model">car.rental.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>