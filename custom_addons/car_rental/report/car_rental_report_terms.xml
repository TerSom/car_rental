<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_car_rental_order_document_inherit_terms" name="Inherit Report" inherit_id="car_rental.report_car_rental_order_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div class="mt-4">
                <h4>Terms &amp; Conditions</h4>
                <ol>
                    <li>The renter must return the vehicle in good condition.</li>
                    <li>Late returns are subject to a daily late fee.</li>
                    <li>Damage beyond normal wear and tear is the renter's responsibility.</li>
                </ol>
            </div>
        </xpath>
    </template>
</odoo>
