<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_car_rental_order_document" name="Car Rental Receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="page-break-after: always; font-size: 13px;">

                        <!-- Header Title & Status -->
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                            <div>
                                <h3 class="fw-bold mb-0 text-primary">CAR RENTAL RECEIPT</h3>
                                <span class="text-muted">No: </span>
                                <strong t-field="doc.name"/>
                            </div>
                            <div class="text-end">
                                <span t-if="doc.state == 'draft'" class="badge px-2 py-1">Draft</span>
                                <span t-if="doc.state == 'confirmed'" class="badge text-white px-2 py-1">Confirmed</span>
                                <span t-if="doc.state == 'done'" class="badge px-2 py-1">Done</span>
                                <span t-if="doc.state == 'cancelled'" class="badge px-2 py-1">Cancelled</span>
                            </div>
                        </div>

                        <!-- Customer & Vehicle Info Cards -->
                        <div class="row mb-3 g-2">
                            <!-- Data Penyewa -->
                            <div class="col-6">
                                <div class="card h-100 border p-2">
                                    <h6 class="fw-bold border-bottom pb-1 mb-2 text-secondary">Customer Information</h6>
                                    <table class="table table-sm table-borderless mb-0">
                                        <tr>
                                            <td class="text-muted p-0" style="width: 35%;">Name</td>
                                            <td class="p-0">: <strong t-field="doc.partner_id.name"/></td>
                                        </tr>
                                        <tr t-if="doc.partner_id.driver_license_number">
                                            <td class="text-muted p-0">Driver License</td>
                                            <td class="p-0">: <span t-field="doc.partner_id.driver_license_number"/></td>
                                        </tr>
                                        <tr t-if="doc.partner_id.phone or doc.partner_id.mobile">
                                            <td class="text-muted p-0">Phone</td>
                                            <td class="p-0">: <span t-out="doc.partner_id.phone or doc.partner_id.mobile"/></td>
                                        </tr>
                                        <tr t-if="doc.partner_id.email">
                                            <td class="text-muted p-0">Email</td>
                                            <td class="p-0">: <span t-field="doc.partner_id.email"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- Data Kendaraan -->
                            <div class="col-6">
                                <div class="card h-100 border p-2">
                                    <h6 class="fw-bold border-bottom pb-1 mb-2 text-secondary">Vehicle Information</h6>
                                    <table class="table table-sm table-borderless mb-0">
                                        <tr>
                                            <td class="text-muted p-0" style="width: 35%;">License Plate</td>
                                            <td class="p-0">: <strong t-field="doc.vehicle_id.license_plate"/></td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted p-0">Model</td>
                                            <td class="p-0">: <span t-field="doc.vehicle_id.brand"/> <span t-field="doc.vehicle_id.model_name"/></td>
                                        </tr>
                                        <tr t-if="doc.vehicle_id.category_id">
                                            <td class="text-muted p-0">Category</td>
                                            <td class="p-0">: <span t-field="doc.vehicle_id.category_id.name"/></td>
                                        </tr>
                                        <tr t-if="doc.vehicle_id.milage">
                                            <td class="text-muted p-0">Mileage</td>
                                            <td class="p-0">: <span t-field="doc.vehicle_id.milage"/> km</td>
                                        </tr>
                                    </table>
                                    <!-- Vehicle features tags -->
                                    <div t-if="doc.vehicle_id.feature_ids" class="mt-2 pt-1 border-top">
                                        <small class="text-muted d-block mb-1">Features:</small>
                                        <t t-foreach="doc.vehicle_id.feature_ids" t-as="feat">
                                            <span class="badge text-dark " t-field="feat.name"/>,
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Rental Details Table -->
                        <table class="table table-sm table-bordered mb-3">
                            <thead class="table-light">
                                <tr class="text-center">
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Duration</th>
                                    <th class="text-end">Daily Rate</th>
                                    <th class="text-end">Total Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="text-center align-middle">
                                    <td><span t-field="doc.date_start"/></td>
                                    <td><span t-field="doc.date_end"/></td>
                                    <td><span t-field="doc.total_days"/> Days</td>
                                    <td class="text-end"><span t-field="doc.vehicle_id.daily_rate"/></td>
                                    <td class="text-end fw-bold"><span t-field="doc.total_amount"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Total Summary Box -->
                        <div class="row justify-content-end mb-3">
                            <div class="col-6">
                                <table class="table table-sm table-borderless border">
                                    <tr class="border-top bg-light">
                                        <td class="fw-bold p-2">Total Payment</td>
                                        <td class="text-end fw-bold p-2 text-primary fs-6">
                                            <span t-field="doc.total_amount"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Notes if present -->
                        <div t-if="doc.notes" class="mb-3 p-2 bg-light border rounded">
                            <strong class="text-muted d-block">Notes:</strong>
                            <span t-field="doc.notes"/>
                        </div>

                        <!-- Signature Section -->
                        <div class="row text-center mt-4 pt-2">
                            <div class="col-6">
                                <p class="mb-5 text-muted">Customer</p>
                                <p class="fw-bold border-top d-inline-block px-4 pt-1 mb-0">
                                    <span t-field="doc.partner_id.name"/>
                                </p>
                            </div>
                            <div class="col-6">
                                <p class="mb-5 text-muted">Authorized Officer</p>
                                <p class="fw-bold border-top d-inline-block px-4 pt-1 mb-0">
                                    ( ..................................... )
                                </p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
