<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="car_rental_feature_action" model="ir.actions.act_window">
        <field name="name">Fitur Mobil</field>
        <field name="res_model">car.rental.feature</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record id="car_rental_feature_view_form" model="ir.ui.view">
        <field name="name">car.rental.feature.view.form</field>
        <field name="model">car.rental.feature</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="car_rental_feature_view_tree" model="ir.ui.view">
        <field name="name">car.rental.feature.view.tree</field>
        <field name="model">car.rental.feature</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

</odoo>
