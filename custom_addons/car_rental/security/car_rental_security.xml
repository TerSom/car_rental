<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="module_category_car_rental" model="ir.module.category">
        <field name="name">Car Rental</field>
        <field name="description">Kategori akses untuk modul Car Retal</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_car_rental_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_car_rental"></field>
    </record>

    <record id="group_car_rental_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_car_rental"></field>
        <field name="implied_ids" eval="[(4, ref('group_car_rental_user'))]" />
    </record>

    <record id="group_car_rental_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="module_category_car_rental" />
        <field name="implied_ids" eval="[(4, ref('group_car_rental_manager'))]" />
    </record>

    <record id="car_rental_order_rule_own" model="ir.rule">
        <field name="name">Car Rental Order: User hanya lihat order miliknya sendiri</field>
        <field name="model_id" ref="model_car_rental_order"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_car_rental_user'))]"/>
    </record>

    <record id="car_rental_vehicle_rule_own" model="ir.rule">
        <field name="name">Car Rental Vehicle: </field>
        <field name="model_id" ref="model_car_rental_vehicle"></field>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('car_rental.group_car_rental_user'))]"/>
    </record>
</odoo>